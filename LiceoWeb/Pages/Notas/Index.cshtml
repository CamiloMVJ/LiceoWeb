@page
@using System.Data
@model LiceoWeb.Pages.Notas.IndexModel
@{ViewData["Title"]="Calificaciones";}
<div class="liceo-page-heading"><h1>Calificaciones</h1><p>Configura evaluaciones, registra resultados y revisa el avance del grupo.</p></div>
@if(Model.Mensaje is not null){<div class="alert alert-success" role="status">@Model.Mensaje</div>}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="get" class="liceo-card mb-4">
 <label for="asignacionId" class="form-label">Grupo y asignatura</label>
 <select id="asignacionId" name="asignacionId" class="form-select mb-3">
 <option value="0">Seleccionar</option>
 @foreach(var item in Model.Opciones("Asignaciones")){<option value="@item.Value" selected="@(item.Value==Model.Input.AsignacionId.ToString())">@item.Text</option>}
 </select><button class="btn btn-liceo-primary">Abrir asignación</button>
 @if(User.IsInRole("Administrador")){<a asp-route-accion="Tipo" class="btn btn-liceo-secondary">Crear tipo de evaluación</a>}
</form>
@if(Model.Bloqueado){<div class="alert alert-info">Resultados publicados o período cerrado. Consulta disponible; edición bloqueada.</div>}
@if(Model.Input.AsignacionId>0){
 <nav class="d-flex gap-2 mb-4"><a asp-route-asignacionId="@Model.Input.AsignacionId" class="btn btn-liceo-secondary">Nueva evaluación</a><a asp-route-asignacionId="@Model.Input.AsignacionId" asp-route-accion="Publicar" class="btn btn-liceo-secondary">Revisar publicación</a></nav>
}
@if(!Model.Bloqueado && (Model.Input.Accion=="Tipo" || Model.Input.AsignacionId>0)){
<form method="post" class="liceo-card mb-4">
 <input asp-for="Input.Accion" type="hidden" /><input asp-for="Input.AsignacionId" type="hidden" /><input asp-for="Input.EvaluacionId" type="hidden" />
 @if(Model.Input.Accion=="Tipo"){
 <h2 class="h4">Nuevo tipo de evaluación</h2><label asp-for="Input.Nombre" class="form-label">Nombre</label><input asp-for="Input.Nombre" class="form-control mb-3" required /><button class="btn btn-liceo-primary">Crear tipo</button>
 }
 @if(Model.Input.Accion=="Evaluacion"){
 <h2 class="h4">Nueva evaluación</h2>
 <div class="row g-3">
 <div class="col-md-6"><label asp-for="Input.Nombre" class="form-label">Nombre</label><input asp-for="Input.Nombre" class="form-control" required /></div>
 <div class="col-md-6"><label asp-for="Input.TipoId" class="form-label">Tipo</label><select asp-for="Input.TipoId" asp-items='Model.Opciones("Tipos")' class="form-select"><option value="0">Seleccionar</option></select></div>
 <div class="col-md-6"><label asp-for="Input.Fecha" class="form-label">Fecha dentro del período</label><input asp-for="Input.Fecha" type="date" class="form-control" required /></div>
 <div class="col-md-6"><label asp-for="Input.Modo" class="form-label">Modalidad de calificación</label><select asp-for="Input.Modo" class="form-select"><option>Cuantitativa</option><option>Cualitativa</option></select></div>
 <div class="col-md-6"><label asp-for="Input.Maximo" class="form-label">Puntos máximos (solo cuantitativa)</label><input asp-for="Input.Maximo" type="number" step="0.01" class="form-control" /></div>
 <div class="col-md-6"><label asp-for="Input.Peso" class="form-label">Peso porcentual (solo cuantitativa)</label><input asp-for="Input.Peso" type="number" step="0.01" class="form-control" /></div>
 <div class="col-12"><label asp-for="Input.Opciones" class="form-label">Escala cualitativa: un resultado por línea</label><textarea asp-for="Input.Opciones" rows="4" class="form-control" aria-describedby="escala-ayuda"></textarea><p id="escala-ayuda" class="text-muted">Define de 2 a 20 opciones para una evaluación cualitativa. Estas no se convierten en puntos ni aportan al promedio numérico.</p></div>
 </div><p class="mt-3">Revisa los datos antes de crear: esta etapa no permite cambiar la definición de una evaluación creada.</p><button class="btn btn-liceo-primary">Crear evaluación</button>
 }
 @if(Model.Input.Accion=="Nota" && Model.Evaluacion is not null && !string.IsNullOrEmpty(Model.Input.Registro)){
 <h2 class="h4">Registrar resultado · @Model.Input.Registro</h2><p>@Model.Evaluacion["Nombre"]</p>
 <input asp-for="Input.Registro" type="hidden" /><input asp-for="Input.Version" type="hidden" />
 @if(Model.Evaluacion["Modo"].ToString()=="Cuantitativa"){
 <label asp-for="Input.Nota" class="form-label">Nota (máximo @Model.Evaluacion["Maximo"] puntos)</label><input asp-for="Input.Nota" type="number" min="0" step="0.01" class="form-control mb-3" />
 }else{
 <label asp-for="Input.Resultado" class="form-label">Resultado</label><select asp-for="Input.Resultado" class="form-select mb-3"><option value="">Pendiente</option>@foreach(var opcion in Model.Filas("Opciones")){<option value="@opcion["Valor"]">@opcion["Valor"]</option>}</select>
 }
 <p class="text-muted">Vacío significa pendiente. Una nota de cero es un resultado registrado.</p>
 <label asp-for="Input.Observacion" class="form-label">Observación académica</label><textarea asp-for="Input.Observacion" class="form-control mb-3" rows="2"></textarea><button class="btn btn-liceo-primary">Guardar resultado</button>
 }
 @if(Model.Input.Accion=="Publicar"){
 <h2 class="h4">Publicar resultados de esta asignatura</h2><p>Se comprobará que no falten resultados y que los pesos numéricos sumen 100 %. Las evaluaciones y notas quedarán bloqueadas. Esta publicación es interna; no envía mensajes ni habilita un portal de padres.</p><button class="btn btn-liceo-primary">Confirmar publicación y bloquear</button>
 }
</form>
}
@if(Model.Input.AsignacionId>0){
<section class="liceo-card mb-4"><h2 class="h4">Evaluaciones</h2><div class="table-responsive"><table class="table"><thead><tr><th>Nombre</th><th>Fecha</th><th>Modalidad</th><th>Máximo</th><th>Peso</th><th>Acción</th></tr></thead><tbody>
@foreach(var e in Model.Filas("Evaluaciones")){<tr><td>@e["Nombre"]</td><td>@(((DateTime)e["Fecha"]).ToString("dd/MM/yyyy"))</td><td>@e["Modo"]</td><td>@(e["Modo"].ToString()=="Cuantitativa"?e["Maximo"]:"—")</td><td>@e["Peso"] %</td><td><a asp-route-asignacionId="@Model.Input.AsignacionId" asp-route-evaluacionId="@e["Id"]" asp-route-accion="Nota">Ver resultados</a></td></tr>}
</tbody></table></div></section>
@if(Model.Evaluacion is not null){
<section class="liceo-card mb-4"><h2 class="h4">Resultados · @Model.Evaluacion["Nombre"]</h2><div class="table-responsive"><table class="table"><thead><tr><th>Estudiante</th><th>Resultado</th><th>Observación</th><th>Acción</th></tr></thead><tbody>
@foreach(var r in Model.Filas("Estudiantes")){<tr><td>@r["NombreEstudiante"] <small>(@r["Registro"])</small></td><td>@(r["Nota"] is not DBNull?r["Nota"]:r["Resultado"] is not DBNull?r["Resultado"]:"Pendiente")</td><td>@r["Observacion"]</td><td>@if(!Model.Bloqueado){<a asp-route-asignacionId="@Model.Input.AsignacionId" asp-route-evaluacionId="@Model.Input.EvaluacionId" asp-route-registro="@r["Registro"]" asp-route-accion="Nota">Calificar</a>}</td></tr>}
</tbody></table></div></section>
}
<section class="liceo-card"><h2 class="h4">Resumen del grupo</h2><p>Acumulado numérico = suma de (nota ÷ máximo × peso). Mientras haya pendientes o falte configurar peso, es un avance parcial. Las escalas cualitativas se consultan por evaluación.</p><partial name="~/Pages/Planificacion/_Tabla.cshtml" model='Model.Datos.Tables["Resumen"]!' /></section>
}
