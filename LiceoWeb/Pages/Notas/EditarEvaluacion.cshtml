@page "{id:int}"
@model LiceoWeb.Pages.Notas.EditarEvaluacionModel
@using System.Data
@{ViewData["Title"]="Definición e historial de evaluación";}
<div class="liceo-page-heading"><h1>Definición e historial de evaluación</h1><p>Solo se puede corregir antes de registrar calificaciones y sin publicaciones en la asignatura.</p></div>
@if(Model.Mensaje is not null){<div class="alert alert-success" role="status">@Model.Mensaje</div>}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if(Model.Evaluacion is { } e)
{
 <a asp-page="Index" asp-route-asignacionId="@e["AsignacionId"]" class="btn btn-liceo-secondary mb-3">Volver a calificaciones</a>
 @if(Model.Bloqueada){<div class="alert alert-info">Edición bloqueada: existen registros de calificaciones, publicaciones o el período está cerrado. El historial sigue disponible.</div>}
 <form method="post" class="liceo-card mb-4">
 <input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/><input asp-for="Input.Operacion" type="hidden"/>
 <fieldset disabled="@Model.Bloqueada"><legend class="h4">Definición actual</legend><div class="row g-3">
 <div class="col-md-6"><label asp-for="Input.Nombre" class="form-label">Nombre</label><input asp-for="Input.Nombre" class="form-control"/></div>
 <div class="col-md-6"><label asp-for="Input.TipoId" class="form-label">Tipo</label><select asp-for="Input.TipoId" asp-items="Model.Tipos" class="form-select"></select></div>
 <div class="col-md-6"><label asp-for="Input.Fecha" class="form-label">Fecha dentro del período</label><input asp-for="Input.Fecha" type="date" class="form-control"/></div>
 <div class="col-md-6"><label asp-for="Input.Modo" class="form-label">Modalidad</label><select asp-for="Input.Modo" class="form-select"><option>Cuantitativa</option><option>Cualitativa</option></select></div>
 <div class="col-md-6"><label asp-for="Input.Maximo" class="form-label">Puntos máximos (cuantitativa)</label><input asp-for="Input.Maximo" type="number" step="0.01" class="form-control"/></div>
 <div class="col-md-6"><label asp-for="Input.Peso" class="form-label">Peso porcentual (cuantitativa)</label><input asp-for="Input.Peso" type="number" step="0.01" class="form-control"/></div>
 <div class="col-12"><label asp-for="Input.Opciones" class="form-label">Escala cualitativa: un resultado por línea</label><textarea asp-for="Input.Opciones" class="form-control" rows="4"></textarea><p class="text-muted">De 2 a 20 resultados diferentes. La escala cualitativa no aporta puntos ni peso numérico.</p></div>
 @if(!Model.Bloqueada){<div class="col-12"><label asp-for="Input.Motivo" class="form-label">Motivo (10–500 caracteres)</label><textarea asp-for="Input.Motivo" maxlength="500" class="form-control" rows="3"></textarea></div>}
 </div>@if(!Model.Bloqueada){<button class="btn btn-liceo-primary mt-3">Guardar definición</button>}</fieldset></form>
 <section class="liceo-card"><h2 class="h4">Historial · @Model.Total cambios</h2><p>Fechas locales de Nicaragua (UTC−6). Hasta 50 por página.</p>
 <div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Responsable</th><th>Antes</th><th>Después</th><th>Motivo</th></tr></thead><tbody>
 @foreach(DataRow h in Model.Datos.Tables["Historial"]!.Rows){<tr><td>@(((DateTime)h["FechaLocal"]).ToString("dd/MM/yyyy HH:mm"))</td><td>@h["Responsable"]</td><td>@LiceoWeb.Pages.Notas.EditarEvaluacionModel.Describir((string)h["AntesJson"])</td><td>@LiceoWeb.Pages.Notas.EditarEvaluacionModel.Describir((string)h["DespuesJson"])</td><td>@h["Motivo"]</td></tr>}
 </tbody></table></div>
 @if(Model.Total==0){<p>Todavía no hay cambios de definición registrados.</p>}
 <nav aria-label="Historial de la evaluación" class="d-flex gap-2 align-items-center">
 @if(Model.Pagina>1){<a asp-route-id="@e["Id"]" asp-route-Pagina="@(Model.Pagina-1)" class="btn btn-liceo-secondary">Anterior</a>}
 <span>Página @Model.Pagina</span>
 @if((long)Model.Pagina*50<Model.Total){<a asp-route-id="@e["Id"]" asp-route-Pagina="@(Model.Pagina+1)" class="btn btn-liceo-secondary">Siguiente</a>}
 </nav></section>
}
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
