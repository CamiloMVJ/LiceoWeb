@page
@model LiceoWeb.Pages.Finanzas.CargosModel
@using System.Data
@{ ViewData["Title"] = "Generar cargos"; }
<h1>Generar cargos</h1>
<p>Asigna una obligación al estudiante usando una tarifa vigente. Esto crea deuda; no registra un pago ni emite un recibo.</p>
@if (Model.Mensaje is not null) { <div class="alert alert-success" role="status">@Model.Mensaje</div> }
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.Cargado)
{
    @if (!Model.Migrado) { <div class="alert alert-warning">El corte financiero no está aplicado. Puedes revisar tarifas y periodicidades, pero todavía no generar cargos.</div> }
    <section class="card card-body mb-3">
        <h2 class="h4">Arancel de matrícula académica</h2>
        @if (Model.Datos.Tables["Matricula"]!.Rows.Count > 0)
        { <p>Configurado: <strong>@Model.Datos.Tables["Matricula"]!.Rows[0]["Nombre"]</strong>. Esta selección se conserva para mantener el historial.</p> }
        else
        {
            <p>Selecciona el arancel anual que respaldará la matrícula. Configurarlo no genera deuda ni inscribe estudiantes.</p>
            <form method="post" asp-page-handler="Matricula">
                <label for="arancel-matricula">Arancel anual activo</label>
                <select id="arancel-matricula" name="arancelId" class="form-select mb-2" required><option value="">Selecciona</option>
                @foreach (DataRow a in Model.Datos.Tables["Aranceles"]!.Rows)
                { if (a["Periodicidad"].ToString()=="Anual") { <option value="@a["Id"]">@a["Nombre"]</option> } }
                </select>
                <button class="btn btn-liceo-primary">Confirmar arancel de matrícula</button>
            </form>
            <p class="mt-2">Si no aparece, crea el arancel en Aranceles y define su periodicidad Anual en el apartado siguiente.</p>
        }
    </section>
    <details class="card card-body mb-4"><summary>Periodicidad de los aranceles</summary>
        <p>Anual: una vez por año y tarifa. Mensual: una vez por mes. Eventual: una vez por código de evento. La configuración queda fija para evitar duplicados por cambios de criterio.</p>
        <table class="table"><thead><tr><th>Arancel</th><th>Periodicidad</th></tr></thead><tbody>
        @foreach (DataRow a in Model.Datos.Tables["Aranceles"]!.Rows) { <tr><td>@a["Nombre"]</td><td>@(a.IsNull("Periodicidad") ? "Sin configurar" : a["Periodicidad"])</td></tr> }
        </tbody></table>
        <form method="post" asp-page-handler="Configurar" class="row g-2">
            <div class="col-md-5"><label for="arancel">Arancel sin configurar</label><select id="arancel" name="arancelId" class="form-select" required><option value="">Selecciona</option>
            @foreach (DataRow a in Model.Datos.Tables["Aranceles"]!.Rows) { if (a.IsNull("Periodicidad")) { <option value="@a["Id"]">@a["Nombre"]</option> } }
            </select></div>
            <div class="col-md-4"><label for="periodicidad">Periodicidad</label><select id="periodicidad" name="periodicidad" class="form-select" required><option value="">Selecciona</option><option>Anual</option><option>Mensual</option><option>Eventual</option></select></div>
            <div class="col-md-3 align-self-end"><button class="btn btn-liceo-primary">Guardar periodicidad</button></div>
        </form>
    </details>
}
<form method="get" class="d-flex gap-2 mb-3"><label for="registro" class="visually-hidden">Buscar estudiante por nombre</label><input data-buscar-estudiante id="registro" name="registro" value="@Model.Input.Registro" maxlength="10" class="form-control" placeholder="Código del estudiante" required /><button class="btn btn-liceo-primary">Buscar</button></form>
@if (Model.Cargado && !string.IsNullOrWhiteSpace(Model.Input.Registro))
{
    @if (Model.Datos.Tables["Estudiante"]!.Rows.Count == 0) { <p>No se encontró ese estudiante.</p> }
    else
    {
        var e = Model.Datos.Tables["Estudiante"]!.Rows[0];
        <h2>@e["NombreEstudiante"]</h2><p>@e["Registro"] · @e["Modalidad"] · @e["Estado"]</p>
        <a asp-page="Cuenta" asp-route-registro="@Model.Input.Registro" class="btn btn-outline-secondary mb-3">Ver estado de cuenta</a>
        <h3>Tarifas disponibles</h3>
        <p>Si no aparece la tarifa, revisa su estado, año, modalidad, importe y periodicidad en Aranceles.</p>
        <div class="table-responsive"><table class="table"><thead><tr><th>Concepto</th><th>Año</th><th>Periodicidad</th><th>Importe (C$)</th><th>Acción</th></tr></thead><tbody>
        @foreach (DataRow t in Model.Datos.Tables["Tarifas"]!.Rows)
        { <tr><td>@t["Nombre"]</td><td>@t["Anio"]</td><td>@t["Periodicidad"]</td><td>@(((decimal)t["Importe"]).ToString("N2"))</td><td><a asp-page="Cargos" asp-route-registro="@Model.Input.Registro" asp-route-tarifaId="@t["Id"]">Seleccionar</a></td></tr> }
        </tbody></table></div>
        @if (Model.Migrado && Model.Tarifa is { } tarifa)
        {
            <form method="post" class="card card-body my-3">
                <h3>@tarifa["Nombre"] · @tarifa["Anio"]</h3><p>Importe: <strong>C$ @(((decimal)tarifa["Importe"]).ToString("N2"))</strong>. Periodicidad: @tarifa["Periodicidad"].</p>
                <input type="hidden" asp-for="Input.Registro" /><input type="hidden" asp-for="Input.TarifaId" /><input type="hidden" asp-for="Input.VersionTarifa" /><input type="hidden" asp-for="Input.Operacion" />
                @if ((string)tarifa["Periodicidad"] == "Mensual")
                { <label asp-for="Input.Mes">Mes de la obligación</label><select asp-for="Input.Mes" class="form-select mb-3" required><option value="">Selecciona</option>@for(var m=1;m<=12;m++){<option value="@m">@m</option>}</select> }
                @if ((string)tarifa["Periodicidad"] == "Eventual")
                { <label asp-for="Input.Evento">Código único del evento</label><input asp-for="Input.Evento" class="form-control mb-3" maxlength="30" required /><small>Ejemplo: EXCURSION_01. Usa el mismo código para el mismo evento; otro código representa otra obligación.</small> }
                @if ((string)tarifa["Periodicidad"] == "Mensual") {
                    <div class="alert alert-info">Para generar varias mensualidades, marca la opción e indica el rango. El mes elegido arriba será el inicial. Requiere matrícula académica. Si cualquier mes ya existe, se rechaza todo el lote; selecciona solo meses nuevos.</div>
                    <label><input asp-for="Input.GenerarRango" /> Generar rango de mensualidades</label>
                    <label asp-for="Input.MesFinal">Mes final (1–12)</label><input asp-for="Input.MesFinal" class="form-control" />
                    <label asp-for="Input.DiaVencimiento">Día de vencimiento para cada mes (1–28)</label><input asp-for="Input.DiaVencimiento" class="form-control" />
                    <p>El importe mostrado se aplica a cada mes del rango. Para el lote, deja vacía la fecha individual siguiente.</p>
                }
                <label asp-for="Input.Vencimiento">Vencimiento (opcional, dentro del año de la tarifa)</label><input asp-for="Input.Vencimiento" class="form-control mb-3" />
                <button class="btn btn-liceo-primary align-self-start">Confirmar y generar cargo</button>
                <small class="text-muted mt-2">Operación: @Model.Input.Operacion. Conserva este formulario si necesitas reintentar tras un error.</small>
            </form>
        }
    }
}
