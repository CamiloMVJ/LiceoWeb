@page
@using System.Data
@model LiceoWeb.Pages.Finanzas.ArancelesModel
@{ViewData["Title"]="Aranceles y tarifas";}
<h1>Aranceles y tarifas</h1>
<p>Configura los conceptos de cobro y sus precios por año y modalidad.</p>
<div class="alert alert-info">Después de configurar las tarifas, asigna los cargos desde Cargos y mensualidades. Los pagos se registran en Estado de cuenta y cobros.</div>
@if(Model.Mensaje is not null){<div class="alert alert-success" role="status">@Model.Mensaje</div>}
<nav class="d-flex flex-wrap gap-2 mb-4" aria-label="Operaciones financieras">@foreach(var a in LiceoWeb.Pages.Finanzas.ArancelesModel.Acciones){<a asp-route-accion="@a" class="btn btn-liceo-secondary">@a</a>}</nav>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<form method="post" class="liceo-card mb-4">
<input asp-for="Input.Accion" type="hidden"/><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.Version" type="hidden"/>
@if(Model.Input.Accion=="Arancel"){
<h2 class="h4">@(Model.Input.Id==0?"Nuevo arancel":"Editar arancel")</h2>
<label asp-for="Input.Codigo" class="form-label">Código</label><input asp-for="Input.Codigo" class="form-control mb-3" required/>
<label asp-for="Input.Nombre" class="form-label">Nombre</label><input asp-for="Input.Nombre" class="form-control mb-3" required/>
<p>Una vez utilizado en tarifas, se conserva su código y nombre. Puedes inactivarlo.</p>
}
@if(Model.Input.Accion=="Tarifa" && Model.Input.Id==0){
<label asp-for="Input.ArancelId" class="form-label">Arancel</label><select asp-for="Input.ArancelId" asp-items='Model.Opciones("Aranceles")' class="form-select mb-3"><option value="0">Seleccionar</option></select>
}
@if(Model.Input.Accion=="Tarifa"){
@if(Model.Input.Id==0){
<label asp-for="Input.AnioId" class="form-label">Año lectivo</label><select asp-for="Input.AnioId" asp-items='Model.Opciones("Anios")' class="form-select mb-3"><option value="0">Seleccionar</option></select>
<label asp-for="Input.ModalidadId" class="form-label">Modalidad</label><select asp-for="Input.ModalidadId" asp-items='Model.Opciones("Modalidades")' class="form-select mb-3"><option value="0">Seleccionar</option></select>
}
else {
<input asp-for="Input.ArancelId" type="hidden" /><input asp-for="Input.AnioId" type="hidden" /><input asp-for="Input.ModalidadId" type="hidden" />
}
<label asp-for="Input.Importe" class="form-label">Importe en córdobas</label><input asp-for="Input.Importe" type="number" min="0" step="0.01" class="form-control mb-3" required/>
<p>Crea años y modalidades en Catálogos académicos. Al editar se conserva la combinación original; los cambios de importe quedan en el historial y no alteran cargos ya registrados.</p>
}
@if(Model.Input.Accion is "Arancel" or "Tarifa"){
<div class="form-check mb-3"><input asp-for="Input.Activo" class="form-check-input"/><label asp-for="Input.Activo" class="form-check-label">Activo</label></div>
}
<label asp-for="Input.Motivo" class="form-label">Motivo</label><textarea asp-for="Input.Motivo" class="form-control mb-3" maxlength="500" required></textarea>
<button class="btn btn-liceo-primary" disabled="@((Model.Input.Id>0 && string.IsNullOrWhiteSpace(Model.Input.Version)) || !Model.Datos.Tables.Contains("Aranceles"))">Guardar</button>
</form>
<section class="liceo-card mb-4"><h2 class="h4">Aranceles</h2><div class="table-responsive"><table class="table"><thead><tr><th>Código</th><th>Nombre</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var r in Model.Filas("Aranceles")){<tr><td>@r["Codigo"]</td><td>@r["Nombre"]</td><td>@((bool)r["Activo"]?"Activo":"Inactivo")</td><td><a asp-route-accion="Arancel" asp-route-id="@r["Id"]">Editar</a></td></tr>}</tbody></table></div></section>
<section class="liceo-card mb-4"><h2 class="h4">Tarifas</h2><div class="table-responsive"><table class="table"><thead><tr><th>Arancel</th><th>Año</th><th>Modalidad</th><th>C$</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var r in Model.Filas("Tarifas")){<tr><td>@r["Arancel"]</td><td>@r["Anio"]</td><td>@r["Modalidad"]</td><td>@(((decimal)r["Importe"]).ToString("N2"))</td><td>@((bool)r["Activo"]?"Activa":"Inactiva")</td><td><a asp-route-accion="Tarifa" asp-route-id="@r["Id"]">Editar</a></td></tr>}</tbody></table></div></section>
<section class="liceo-card mb-4"><h2 class="h4">Historial de tarifas</h2><p>Se muestran hasta 200 cambios de tarifas.</p>
<partial name="~/Pages/Planificacion/_Tabla.cshtml" model='@(Model.Datos.Tables["Historial"] ?? new DataTable())'/></section>
