@page "{id:long}"
@model LiceoWeb.Pages.Finanzas.ReciboModel
@using System.Data
@{ ViewData["Title"] = "Recibo"; var r = Model.Datos.Tables["Recibo"]!.Rows[0]; }
<partial name="_DetalleRecibo" model="Model.Datos" />
<p class="mt-3"><a class="btn btn-liceo-primary" asp-page="Cuenta" asp-route-registro="@r["Registro"]">Volver al estado de cuenta</a></p>
<p><a class="btn btn-outline-secondary" asp-page="ImprimirRecibo" asp-route-id="@r["Id"]">Versión para imprimir o guardar PDF</a></p>

@if (User.IsInRole("Administrador") && Model.Datos.Tables["Anulacion"]!.Rows.Count == 0)
{ <a class="btn btn-outline-danger" asp-page="AnularRecibo" asp-route-id="@r["Id"]">Revisar anulación</a> }
