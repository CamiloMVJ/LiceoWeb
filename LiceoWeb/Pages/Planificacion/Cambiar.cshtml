@page
@model LiceoWeb.Pages.Planificacion.CambiarModel
@{ViewData["Title"]=Model.Input.Tipo=="Docente"?"Cambiar docente":"Trasladar estudiante";}
<div class="liceo-page-heading"><h1>@ViewData["Title"]</h1><p>Confirma el destino y explica el motivo. Se conservarán los datos anteriores y el responsable del cambio.</p></div>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if(Model.Origen is { } origen)
{
 <section class="liceo-card mb-3"><h2 class="h4">Origen</h2><p>@origen["Descripcion"]</p></section>
 <form method="post" class="liceo-card">
 <input asp-for="Retorno" type="hidden" /><input asp-for="Input.Tipo" type="hidden"/><input asp-for="Input.OrigenId" type="hidden"/><input asp-for="Input.Registro" type="hidden"/><input asp-for="Input.Version" type="hidden"/><input asp-for="Input.Operacion" type="hidden"/>
 @if(Model.Input.Tipo=="Docente")
 {
  <label asp-for="Input.DocenteId" class="form-label">Nuevo docente</label><select asp-for="Input.DocenteId" asp-items="Model.Destinos" class="form-select"><option value="">Seleccionar</option></select><span asp-validation-for="Input.DocenteId" class="text-danger"></span>
  @if(Model.DocentesOcupados.Any())
  {
   <div class="alert alert-warning mt-3">
    <p class="mb-1"><strong>Docentes no disponibles para este horario</strong></p>
    <ul class="mb-0">@foreach(var ocupado in Model.DocentesOcupados){<li><strong>@ocupado.Docente:</strong> @ocupado.Detalle</li>}</ul>
   </div>
  }
  @if(!Model.HayDestinoDisponible){<p role="status">No hay docentes disponibles para el cambio.</p>}
  <p class="text-muted">Si la clase aún no tiene horario, la disponibilidad se comprobará al agregar sus bloques. Las notas existentes conservan su autoría. No se permite cambiar si el período está cerrado o la asignatura tiene publicaciones.</p>
 }
 else
 {
  <label asp-for="Input.GrupoDestino" class="form-label">Grupo de destino</label><select asp-for="Input.GrupoDestino" asp-items="Model.Destinos" class="form-select"><option value="">Seleccionar</option></select><span asp-validation-for="Input.GrupoDestino" class="text-danger"></span>
  <p class="text-muted">Solo grupos del mismo pensum y período. El cupo se confirma al guardar. No se permite si el estudiante tiene registros de calificaciones o alguno de los grupos tiene publicaciones. Se conserva su matrícula y sus cargos.</p>
 }
 <label asp-for="Input.Motivo" class="form-label">Motivo</label><textarea asp-for="Input.Motivo" class="form-control" rows="3" maxlength="500" aria-describedby="motivo-ayuda"></textarea><span asp-validation-for="Input.Motivo" class="text-danger"></span>
 <p id="motivo-ayuda" class="text-muted">Entre 10 y 500 caracteres.</p><button class="btn btn-liceo-primary" disabled="@(Model.Input.Tipo=="Docente" && !Model.HayDestinoDisponible)">Confirmar cambio</button>
 </form>
}
<div class="d-flex flex-wrap gap-2 mt-3"><a href="@Model.Volver" class="btn btn-liceo-secondary">Volver al grupo</a><a asp-page="HistorialCambios" class="btn btn-liceo-secondary">Historial de cambios</a></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
