@page
@model LiceoWeb.Pages.Planificacion.HistorialHorariosModel
@using System.Data
@{ViewData["Title"]="Historial de horarios";}
<div class="liceo-page-heading"><h1>Historial de horarios cancelados</h1><p>Datos de la clase al cancelar. Fechas de cancelación en hora de Nicaragua (UTC−6).</p><a asp-page="Index" asp-route-accion="Horario" class="btn btn-liceo-secondary">Volver a planificación</a></div>
@if(Model.Mensaje is not null){<div class="alert alert-success" role="status">@Model.Mensaje</div>}
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if(Model.Cargado)
{
 <p>@Model.Total cancelaciones · hasta 50 por página.</p>
 <div class="table-responsive"><table class="table liceo-table"><thead><tr><th>Horario</th><th>Año / período</th><th>Clase</th><th>Docente / aula</th><th>Día / horas</th><th>Cancelación</th><th>Responsable</th><th>Motivo</th></tr></thead><tbody>
 @foreach(DataRow h in Model.Datos.Tables["Historial"]!.Rows)
 {<tr><td>@h["HorarioId"]</td><td>@h["Anio"] / @h["Periodo"]</td><td>@h["Asignatura"] · @h["Seccion"]</td><td>@h["Docente"] / @h["Aula"]</td><td>@h["Dia"] · @h["Inicio"]–@h["Fin"]</td><td>@(((DateTime)h["FechaLocal"]).ToString("dd/MM/yyyy HH:mm"))</td><td>@h["Responsable"]</td><td>@h["Motivo"]</td></tr>}
 </tbody></table></div>
 @if(Model.Total==0){<p>Todavía no hay horarios cancelados.</p>}
 <nav aria-label="Páginas del historial" class="d-flex align-items-center gap-2">
 @if(Model.Pagina>1){<a asp-route-Pagina="@(Model.Pagina-1)" class="btn btn-liceo-secondary">Anterior</a>}
 <span>Página @Model.Pagina</span>
 @if((long)Model.Pagina*50<Model.Total){<a asp-route-Pagina="@(Model.Pagina+1)" class="btn btn-liceo-secondary">Siguiente</a>}
 </nav>
}
