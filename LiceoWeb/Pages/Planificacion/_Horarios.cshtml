@model IEnumerable<System.Data.DataRow>
@using System.Data
@{
    string[] dias = ["Lunes", "Martes", "Miércoles", "Jueves", "Viernes", "Sábado", "Domingo"];
    var porDia = Model.Where(r => r["Dia"] is not DBNull).ToLookup(r => Convert.ToInt32(r["Dia"]));
    var edicion = ViewData["HorarioEdicion"] as string;
    var docente = ViewData["HorarioDocente"] is true;
    string Hora(TimeSpan hora) => hora.ToString(@"hh\:mm");
}
<div class="horario-semana" tabindex="0" role="region" aria-label="Horario semanal; desplázate para ver todos los días">
@for (var i = 1; i <= dias.Length; i++)
{
    var bloques = porDia[i].OrderBy(r => r.Field<TimeSpan>("Inicio")).ToArray();
    var dia = dias[i-1];
    TimeSpan? finAnterior = null;
    <section class="horario-dia" aria-label="@dia">
        <header><h3>@dia</h3><span>@bloques.Length @(bloques.Length == 1 ? "bloque" : "bloques")</span></header>
        @if (bloques.Length == 0) { <p class="horario-vacio">Sin clases</p> }
        @foreach (var h in bloques)
        {
            var inicio = h.Field<TimeSpan>("Inicio");
            var fin = h.Field<TimeSpan>("Fin");
            if (finAnterior is { } anterior && inicio > anterior)
            {
                <p class="horario-pausa">Libre · @Hora(anterior)–@Hora(inicio)</p>
            }
            if (finAnterior is null || fin > finAnterior) finAnterior = fin;
            <article class="horario-bloque">
                <p class="horario-hora">@Hora(inicio)–@Hora(fin)</p>
                <h4>@h["Asignatura"]</h4>
                <p>@(docente ? $"Sección {h["Seccion"]}" : h["Docente"])<br />@h["Aula"]</p>
                @if (edicion is not null)
                {
                    <div class="horario-acciones">
                        @if (h.Table.Columns.Contains("VersionHorario"))
                        { <a href="@(edicion + "&bloque=" + h.Field<int>("Id") + "#formulario-plan")">Reprogramar</a> }
                        <a asp-page="/Planificacion/CancelarHorario" asp-route-retorno='@(edicion + "#horario-semanal")' asp-route-id="@h["Id"]">Cancelar bloque</a>
                    </div>
                }
            </article>
        }
        @if (edicion is not null)
        {
            <a href="@(edicion + "&dia=" + i + "#formulario-plan")" class="btn btn-sm btn-liceo-secondary horario-agregar" aria-label="Agregar bloque el @dia">+ Agregar bloque</a>
        }
    </section>
}
</div>
