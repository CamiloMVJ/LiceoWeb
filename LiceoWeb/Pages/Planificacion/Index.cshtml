@page
@using System.Data
@model LiceoWeb.Pages.Planificacion.IndexModel
@{ViewData["Title"]="Organización académica";ViewData["RetornoAcademico"]=Model.Enlace(Model.Input.Accion);}
<div class="liceo-page-heading"><p class="text-uppercase small">Gestión académica</p><h1>Organización académica</h1><p>Prepara el año, organiza cada grupo y continúa con sus calificaciones desde un mismo recorrido.</p></div>
@if(Model.Mensaje is not null){<div class="alert alert-success" role="status">@Model.Mensaje</div>}
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
@if(Model.Cargado){
<form method="get" class="liceo-card mb-4 academic-context" data-contexto-academico>
<input type="hidden" name="accion" value="@Model.Input.Accion" />
<h2 class="h5">Estás trabajando en</h2>
<div class="row g-3">
<div class="col-md-3"><label for="anio" class="form-label">Año lectivo</label><select id="anio" name="anio" class="form-select"><option value="0">Seleccionar año</option>@foreach(var r in Model.Contexto.Opciones("Anios")){<option value="@r["Id"]" selected="@((int)r["Id"]==Model.Anio)">@r["Etiqueta"]</option>}</select></div>
<div class="col-md-4"><label for="pensum" class="form-label">Plan de estudios (grado)</label><select id="pensum" name="pensum" class="form-select"><option value="0">Seleccionar plan</option>@foreach(var r in Model.Contexto.Opciones("Pensums")){<option value="@r["Id"]" selected="@((int)r["Id"]==Model.Pensum)">@r["Etiqueta"]</option>}</select></div>
<div class="col-md-3"><label for="grupo" class="form-label">Grupo</label><select id="grupo" name="grupo" class="form-select"><option value="0">Seleccionar grupo</option>@foreach(var r in Model.Contexto.Opciones("Grupos")){<option value="@r["Id"]" selected="@((int)r["Id"]==Model.Grupo)">@r["Etiqueta"]</option>}</select></div>
<div class="col-md-2 d-flex align-items-end"><button class="btn btn-liceo-secondary">Aplicar selección</button></div>
</div><p class="small text-muted mt-2 mb-0">Al cambiar de año se limpian el plan y el grupo. Los cambios sin guardar del formulario se perderán.</p>
</form>
<nav class="academic-steps mb-4" aria-label="Pasos de organización académica">
@for(var i=0;i<LiceoWeb.Pages.Planificacion.IndexModel.Acciones.Length;i++){
var paso=LiceoWeb.Pages.Planificacion.IndexModel.Acciones[i];
<a href="@Model.Enlace(paso)" class="@(Model.Input.Accion==paso?"is-current":"")" aria-current="@(Model.Input.Accion==paso?"step":null)"><span>@(i+1)</span>@LiceoWeb.Pages.Planificacion.IndexModel.Titulo(paso)</a>
}
</nav>
<div class="academic-workspace">
<section>
@if(Model.Input.Accion=="Base"){
<div class="liceo-card mb-4"><h2 class="h4">1. Prepara los datos del colegio</h2><p>Crea el año y sus períodos. Los demás catálogos se reutilizan entre años; no necesitas volver a crearlos.</p>
<nav class="d-flex flex-wrap gap-2" aria-label="Datos del colegio">@foreach(var tipo in LiceoWeb.Pages.Planificacion.CatalogosModel.Tipos){<a href="@Model.Enlace("Base",tipo)" class="btn @(Model.Catalogo.Tipo==tipo?"btn-liceo-primary":"btn-liceo-secondary")">@(tipo=="Anios"?"Años":tipo=="Periodos"?"Períodos":tipo)</a>}</nav></div>
}
@if(Model.Input.Accion!="Base" && Model.Input.Accion!="Listo"){
<div class="liceo-card mb-3"><h2 class="h5">¿Falta una opción?</h2><div class="d-flex flex-wrap gap-2">
@foreach(var tipo in Model.Input.Accion switch {"Pensum"=>new[]{"Modalidades"},"Materia"=>new[]{"Asignaturas"},"Grupo"=>new[]{"Periodos","Turnos","Aulas"},_=>Array.Empty<string>()}){
<a href="@Model.Enlace(Model.Input.Accion,tipo)#catalogo" class="btn btn-sm btn-liceo-secondary">Agregar @(tipo=="Periodos"?"período":tipo=="Turnos"?"turno":tipo=="Aulas"?"aula":tipo=="Asignaturas"?"asignatura":"modalidad") aquí</a>}
@if(Model.Input.Accion=="Docente"){<a asp-page="/Personal/Index">Administrar cuentas de profesores</a>}
<span class="small text-muted">Usa las opciones existentes antes de crear otras.</span></div></div>
}
@if(Model.MostrarCatalogo){
<div id="catalogo"><partial name="~/Pages/Planificacion/_CatalogoFormulario.cshtml" model="Model" /></div>
@if(Model.Input.Accion!="Base"){<p><a href="@Model.Enlace(Model.Input.Accion)">Cancelar y volver al paso</a></p>}
<section class="liceo-card mb-4"><h2 class="h5">Registros existentes · @Model.Catalogo.Tipo</h2>
<div class="table-responsive"><table class="table"><thead><tr><th>Nombre</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach(var r in Model.Contexto.Filas(Model.Catalogo.Tipo).Where(r=>Model.Catalogo.Tipo!="Periodos" || Model.Anio==0 || r.Field<int>("AnioId")==Model.Anio)){
<tr><td>@r["Etiqueta"]</td><td>@(r.Table.Columns.Contains("Activo")?(r.Field<bool>("Activo")?"Activo":"Inactivo"):(r.Field<bool>("Cerrado")?"Cerrado":"Abierto"))</td><td><a href="@Model.Enlace(Model.Input.Accion,Model.Catalogo.Tipo,(int)r["Id"])#catalogo">Editar</a>
@if(r.Table.Columns.Contains("Activo")){
<form method="post" asp-page-handler="Catalogo" class="d-inline"><partial name="~/Pages/Planificacion/_ContextoCampos.cshtml" model="Model" /><input asp-for="Input.Accion" type="hidden" /><input type="hidden" name="Catalogo.Tipo" value="@Model.Catalogo.Tipo" /><input type="hidden" name="Catalogo.Id" value="@r["Id"]" /><input type="hidden" name="Catalogo.SoloEstado" value="true" /><input type="hidden" name="Catalogo.Activo" value="@(r.Field<bool>("Activo")?"false":"true")" /><button class="btn btn-sm btn-liceo-secondary">@(r.Field<bool>("Activo")?"Inactivar":"Activar")</button></form>
}</td></tr>}
</tbody></table></div><p class="small text-muted">Los datos ya utilizados conservan su definición histórica. Inactivarlos evita nuevas selecciones; no elimina los registros existentes.</p></section>
}
@if(Model.Pendiente is not null){<div class="alert alert-info" role="status">@Model.Pendiente</div>}
else if(Model.Input.Accion is not ("Base" or "Listo") && !Model.MostrarCatalogo){<partial name="~/Pages/Planificacion/_PlanFormulario.cshtml" model="Model" />}
@if(Model.Input.Accion=="Materia"){
<section class="liceo-card mb-4"><h2 class="h4">Materias del plan seleccionado</h2><ul>@foreach(var r in Model.Contexto.Materias){<li>@r["Asignatura"]</li>}</ul><p>Completa todas las materias antes de crear el primer grupo: desde ese momento se conserva el plan histórico.</p></section>
}
@if(Model.Input.Accion is "Grupo" or "Listo"){
<section class="liceo-card mb-4"><h2 class="h4">Grupos del plan seleccionado</h2>@foreach(var r in Model.Contexto.Opciones("Grupos")){<p><a asp-page="Index" asp-route-accion="Docente" asp-route-anio="@Model.Anio" asp-route-pensum="@Model.Pensum" asp-route-grupo="@r["Id"]">Organizar @r["Etiqueta"]</a></p>}</section>
}
@if(Model.Grupo>0 && Model.Input.Accion is "Docente" or "Horario" or "Listo"){
<section class="liceo-card mb-4"><h2 class="h4">Clases del grupo</h2><div class="table-responsive"><table class="table"><thead><tr><th>Materia</th><th>Docente</th><th>Acciones</th></tr></thead><tbody>
@foreach(var r in Model.Contexto.Asignaciones){<tr><td>@r["Asignatura"]</td><td>@r["Docente"]</td><td><a asp-page="/Notas/Index" asp-route-asignacionId="@r["Id"]">Abrir calificaciones</a> · <a asp-page="Cambiar" asp-route-retorno="@Model.Enlace(Model.Input.Accion)" asp-route-tipo="Docente" asp-route-origenId="@r["Id"]">Cambiar docente</a></td></tr>}
</tbody></table></div>@if(!Model.Contexto.Asignaciones.Any()){<p>Asigna un docente a cada materia en el paso 5.</p>}</section>
}
@if(Model.Grupo>0 && Model.Input.Accion=="Horario"){
var tabla=Model.Contexto.Filas("Horario").FirstOrDefault()?.Table.Clone();
if(tabla is not null){foreach(var r in Model.Contexto.Horarios){tabla.ImportRow(r);}<section class="liceo-card mb-4"><h2 class="h4">Horario de este grupo</h2><partial name="~/Pages/Planificacion/_Horarios.cshtml" model="tabla" /></section>}
}
@if(Model.Grupo>0 && Model.Input.Accion=="Estudiante"){
var tabla=Model.Contexto.Filas("EstudiantesGrupo").FirstOrDefault()?.Table.Clone();
if(tabla is not null){foreach(var r in Model.Contexto.Estudiantes){tabla.ImportRow(r);}<section class="liceo-card mb-4"><h2 class="h4">Estudiantes de este grupo</h2><partial name="~/Pages/Planificacion/_EstudiantesGrupo.cshtml" model="tabla" /></section>}
}
@if(Model.Input.Accion!="Listo"){<a href="@Model.Enlace(Model.Siguiente)" class="btn btn-liceo-secondary">Continuar: @LiceoWeb.Pages.Planificacion.IndexModel.Titulo(Model.Siguiente)</a>}
</section>
<aside class="liceo-card academic-summary" aria-label="Resumen del contexto">
<h2 class="h5">Tu recorrido</h2><p><strong>Año</strong><br />@Model.Contexto.Etiqueta("Anios",Model.Anio)</p><p><strong>Plan</strong><br />@Model.Contexto.Etiqueta("Pensums",Model.Pensum)</p><p><strong>Grupo</strong><br />@Model.Contexto.Etiqueta("Grupos",Model.Grupo)</p>
@if(Model.Pensum>0){<p><strong>@Model.Contexto.Materias.Count()</strong> materias en el plan</p>}
@if(Model.Grupo>0){
<p><strong>@Model.Contexto.Asignaciones.Count()</strong> materias con docente</p><p><strong>@Model.Contexto.Horarios.Count()</strong> bloques de horario</p><p><strong>@Model.Contexto.Estudiantes.Count()</strong> estudiantes inscritos</p>
@if(Model.Contexto.Materias.Count()>Model.Contexto.Asignaciones.Count()){<p class="text-muted">Faltan materias por asignar a docentes.</p>}
@if(!Model.Contexto.Estudiantes.Any()){<p class="text-muted">Inscribe estudiantes antes de registrar resultados.</p>}
}
<p class="small text-muted">Estos conteos orientan la preparación. Las validaciones de matrícula, cruces de horario y publicación se comprueban al guardar.</p>
<details><summary>Consultas e historial</summary><p class="mt-2"><a asp-page="HistorialHorarios">Horarios cancelados</a></p><p><a asp-page="HistorialCambios">Cambios académicos</a></p><p><a asp-page="/Notas/Cierre">Cierre e historial académico</a></p></details>
</aside></div>
}
@section Scripts{<partial name="_ValidationScriptsPartial" /><script src="~/js/flujo-academico.js" asp-append-version="true"></script>}
