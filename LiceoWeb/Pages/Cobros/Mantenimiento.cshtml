@* @page
@model LiceoWeb.Pages.Cobros.IndexModel
@{

    ViewData["Title"] = "Cobros - Mantenimiento";
} *@

@page
@{
    ViewData["Title"] = "Módulo General de Cobros";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cobros - LiceoWeb</title>
    <!-- Bootstrap 5 CSS y Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />
    
    <style>
        :root {
            --bg-principal: #F4F6F8;
            --btn-principal: #1B264F;
            --extra-accent: #C99700;
        }

        body {
            background-color: var(--bg-principal);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #2D3748;
        }

        /* Contenedores y Tarjetas */
        .card-custom {
            border: none;
            border-radius: 12px;
            background-color: #FFFFFF;
            box-shadow: 0 4px 15px rgba(27, 38, 79, 0.06);
            transition: transform 0.2s ease-in-out;
        }

        .header-box {
            background-color: #FFFFFF;
            border-left: 5px solid var(--extra-accent);
            border-radius: 8px;
            padding: 1.25rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        /* Botones personalizados */
        .btn-custom-primary {
            background-color: var(--btn-principal);
            color: #FFFFFF;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.6rem 1.4rem;
            border: none;
            transition: all 0.2s;
        }

        .btn-custom-primary:hover {
            background-color: #121A38;
            color: #FFFFFF;
            box-shadow: 0 4px 10px rgba(27, 38, 79, 0.25);
        }

        .btn-custom-accent {
            background-color: var(--extra-accent);
            color: #FFFFFF;
            font-weight: 600;
            border-radius: 8px;
            padding: 0.6rem 1.4rem;
            border: none;
            transition: all 0.2s;
        }

        .btn-custom-accent:hover {
            background-color: #A87E00;
            color: #FFFFFF;
            box-shadow: 0 4px 10px rgba(201, 151, 0, 0.3);
        }

        /* Pestañas (Tabs) */
        .nav-pills .nav-link {
            color: var(--btn-principal);
            font-weight: 600;
            border-radius: 8px;
            padding: 0.75rem 1.25rem;
            background-color: #FFFFFF;
            border: 1px solid #E2E8F0;
            margin-right: 8px;
            transition: all 0.2s;
        }

        .nav-pills .nav-link:hover {
            background-color: #EBF1F5;
        }

        .nav-pills .nav-link.active {
            background-color: var(--btn-principal) !important;
            color: #FFFFFF !important;
            border-color: var(--btn-principal);
            box-shadow: 0 3px 8px rgba(27, 38, 79, 0.2);
        }

        /* Insignias y Resaltados */
        .badge-extra {
            background-color: var(--extra-accent);
            color: #FFFFFF;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: 6px;
            padding: 0.4rem 0.8rem;
        }

        .table-custom th {
            background-color: var(--btn-principal);
            color: #FFFFFF;
        }

        .summary-card {
            background-color: #F8FAFC;
            border-radius: 10px;
            border: 1px dashed #CBD5E1;
        }
    </style>
</head>
<body>

<div class="container py-4">

    <!-- ENCABEZADO PRINCIPAL -->
    <div class="header-box mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold m-0" style="color: var(--btn-principal);">
                <i class="bi bi-wallet2 me-2"></i>Módulo Unificado de Cobros
            </h2>
            <p class="text-muted m-0 mt-1">Gestión rápida de Mantenimiento, EvBoTa y Promoción</p>
        </div>
        <div class="text-end">
            <span class="badge badge-extra"><i class="bi bi-calendar3 me-1"></i> Año Lectivo: 2026</span>
        </div>
    </div>

    <!-- PESTAÑAS DE NAVEGACIÓN ENTRE COBROS -->
    <ul class="nav nav-pills mb-4" id="cobrosTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="mantenimiento-tab" data-bs-toggle="tab" data-bs-target="#mantenimiento-pane" type="button" role="tab">
                <i class="bi bi-tools me-2"></i>1. Mantenimiento
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="evbota-tab" data-bs-toggle="tab" data-bs-target="#evbota-pane" type="button" role="tab">
                <i class="bi bi-card-checklist me-2"></i>2. EvBoTa
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="promocion-tab" data-bs-toggle="tab" data-bs-target="#promocion-pane" type="button" role="tab">
                <i class="bi bi-mortarboard-fill me-2"></i>3. Promoción
            </button>
        </li>
    </ul>

    <!-- CONTENIDO DE CADA COBRO -->
    <div class="tab-content" id="cobrosTabContent">

        <!-- ================= 1. PESTAÑA: MANTENIMIENTO ================= -->
        <div class="tab-pane fade show active" id="mantenimiento-pane" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card card-custom p-4">
                        <h5 class="fw-bold mb-3" style="color: var(--btn-principal);">
                            <i class="bi bi-search me-2"></i>Buscar Estudiante
                        </h5>
                        <form onsubmit="return false;">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Código o Registro del Estudiante</label>
                                <input type="text" class="form-control" placeholder="Ej. E_0000001" value="E_0000001">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Año a Consultar</label>
                                <input type="number" class="form-control" value="2026">
                            </div>
                            <button type="button" class="btn btn-custom-primary w-100">
                                <i class="bi bi-search me-1"></i> Consultar Deuda
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card card-custom p-4">
                        <h5 class="fw-bold mb-3" style="color: var(--btn-principal);">
                            <i class="bi bi-receipt me-2"></i>Detalle y Registro de Pago
                        </h5>
                        
                        <div class="summary-card p-3 mb-3">
                            <div class="row">
                                <div class="col-6 mb-2"><span class="text-muted">Estudiante:</span> <br><strong>Juan Pérez Gómez</strong></div>
                                <div class="col-6 mb-2"><span class="text-muted">Modalidad / Grado:</span> <br><strong>Secundaria - 5to Año</strong></div>
                                <div class="col-6"><span class="text-muted">Estado Deuda:</span> <br><span class="badge bg-warning text-dark">Pendiente</span></div>
                                <div class="col-6"><span class="text-muted">Monto Total:</span> <br><strong class="fs-5" style="color: var(--btn-principal);">$350.00</strong></div>
                            </div>
                        </div>

                        <form onsubmit="return false;">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Método de Pago</label>
                                    <select class="form-select">
                                        <option value="Efectivo">Efectivo</option>
                                        <option value="Transferencia">Transferencia</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Nº Referencia / Depósito</label>
                                    <input type="text" class="form-control" placeholder="Opcional para efectivo">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Monto Recibido</label>
                                    <input type="number" class="form-control" placeholder="0.00" value="400.00">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Cambio a Devolver</label>
                                    <input type="text" class="form-control fw-bold text-success" value="$50.00" readonly>
                                </div>
                            </div>

                            <div class="mt-4 text-end">
                                <button type="button" class="btn btn-custom-accent px-4 me-2">
                                    <i class="bi bi-printer me-1"></i> Abrir Recibo
                                </button>
                                <button type="button" class="btn btn-custom-primary px-4">
                                    <i class="bi bi-check-circle me-1"></i> Cobrar Mantenimiento
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= 2. PESTAÑA: EVBOTA ================= -->
        <div class="tab-pane fade" id="evbota-pane" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card card-custom p-4">
                        <h5 class="fw-bold mb-3" style="color: var(--btn-principal);">
                            <i class="bi bi-search me-2"></i>Buscar Estudiante (EvBoTa)
                        </h5>
                        <form onsubmit="return false;">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Código o Registro</label>
                                <input type="text" class="form-control" placeholder="Ej. E_0000002">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Año Lectivo</label>
                                <input type="number" class="form-control" value="2026">
                            </div>
                            <button type="button" class="btn btn-custom-primary w-100">
                                <i class="bi bi-search me-1"></i> Consultar EvBoTa
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card card-custom p-4">
                        <h5 class="fw-bold mb-3" style="color: var(--btn-principal);">
                            <i class="bi bi-file-earmark-check me-2"></i>Evaluaciones, Boletín y Tarjeta
                        </h5>

                        <div class="summary-card p-3 mb-3">
                            <div class="row">
                                <div class="col-6 mb-2"><span class="text-muted">Estudiante:</span> <br><strong>María López Silva</strong></div>
                                <div class="col-6 mb-2"><span class="text-muted">Modalidad / Grado:</span> <br><strong>Primaria - 3er Grado</strong></div>
                                <div class="col-6"><span class="text-muted">Costo EvBoTa:</span> <br><strong class="fs-5" style="color: var(--btn-principal);">$200.00</strong></div>
                                <div class="col-6"><span class="text-muted">Estado:</span> <br><span class="badge bg-danger">Pendiente</span></div>
                            </div>
                        </div>

                        <form onsubmit="return false;">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Método de Pago</label>
                                    <select class="form-select">
                                        <option value="Efectivo">Efectivo</option>
                                        <option value="Transferencia">Transferencia</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Referencia</label>
                                    <input type="text" class="form-control" placeholder="Nº de comprobante">
                                </div>
                            </div>

                            <div class="mt-4 text-end">
                                <button type="button" class="btn btn-custom-accent px-4 me-2">
                                    <i class="bi bi-printer me-1"></i> Imprimir Recibo
                                </button>
                                <button type="button" class="btn btn-custom-primary px-4">
                                    <i class="bi bi-credit-card me-1"></i> Registrar Pago EvBoTa
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= 3. PESTAÑA: PROMOCIÓN ================= -->
        <div class="tab-pane fade" id="promocion-pane" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card card-custom p-4">
                        <h5 class="fw-bold mb-3" style="color: var(--btn-principal);">
                            <i class="bi bi-search me-2"></i>Buscar Promoción Pendiente
                        </h5>
                        <form onsubmit="return false;">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Registro del Estudiante</label>
                                <input type="text" class="form-control" placeholder="Ej. E_0000003">
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-semibold">Año de Promoción</label>
                                <input type="number" class="form-control" value="2026">
                            </div>
                            <button type="button" class="btn btn-custom-primary w-100">
                                <i class="bi bi-search me-1"></i> Buscar Promoción
                            </button>
                        </form>
                    </div>
                </div>

                <div class="col-lg-7">
                    <div class="card card-custom p-4">
                        <h5 class="fw-bold mb-3" style="color: var(--btn-principal);">
                            <i class="bi bi-mortarboard me-2"></i>Cobro de Promoción y Ajustes
                        </h5>

                        <div class="summary-card p-3 mb-3">
                            <div class="row">
                                <div class="col-6 mb-2"><span class="text-muted">Estudiante:</span> <br><strong>Carlos Rodríguez</strong></div>
                                <div class="col-6 mb-2"><span class="text-muted">Saldo Disponible:</span> <br><strong class="text-success">$50.00</strong></div>
                                <div class="col-6"><span class="text-muted">Costo Promoción:</span> <br><strong class="fs-5" style="color: var(--btn-principal);">$500.00</strong></div>
                                <div class="col-6"><span class="text-muted">Mensualidades:</span> <br><span class="badge bg-success">Al día</span></div>
                            </div>
                        </div>

                        <form onsubmit="return false;">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Dinero Nuevo a Ingresar</label>
                                    <input type="number" class="form-control" value="450.00">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Saldo Anterior a Usar</label>
                                    <input type="number" class="form-control" value="50.00" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">Método de Pago</label>
                                    <select class="form-select">
                                        <option value="Efectivo">Efectivo</option>
                                        <option value="Transferencia">Transferencia</option>
                                        <option value="Saldo">Saldo a favor</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold">¿Graduación / Baja?</label>
                                    <select class="form-select">
                                        <option value="No">No (Continúa activo)</option>
                                        <option value="Si">Sí (Registrar baja por graduación)</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mt-4 text-end">
                                <button type="button" class="btn btn-custom-accent px-4 me-2">
                                    <i class="bi bi-printer me-1"></i> Generar Comprobante
                                </button>
                                <button type="button" class="btn btn-custom-primary px-4">
                                    <i class="bi bi-cash-stack me-1"></i> Cancelar Promoción
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>

<!-- Bootstrap 5 JS Bundle -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>