@page
@model LiceoWeb.Pages.Estudiantes.ExpedienteModel
@{ ViewData["Title"] = "Expediente del estudiante"; }
<div class="liceo-page-heading"><h1>Expediente del estudiante</h1><p>Datos personales, responsables y seguridad escolar.</p></div>
@if(Model.Mensaje is not null) { <div class="alert alert-success" role="status">@Model.Mensaje</div> }
<form method="post" class="liceo-card">
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<input asp-for="Input.Registro" type="hidden" />
<input asp-for="Input.Version" type="hidden" />
<fieldset class="mb-4"><legend>Datos del estudiante</legend><div class="row g-3"><div class="col-md-6"><label asp-for="Input.NombreEstudiante" class="form-label">Nombre completo</label><input asp-for="Input.NombreEstudiante" type="text" class="form-control" /><span asp-validation-for="Input.NombreEstudiante" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.FechaNacimiento" class="form-label">Fecha de nacimiento</label><input asp-for="Input.FechaNacimiento" type="date" class="form-control" /><span asp-validation-for="Input.FechaNacimiento" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Identificacion" class="form-label">Identificación (si dispone)</label><input asp-for="Input.Identificacion" type="text" class="form-control" /><span asp-validation-for="Input.Identificacion" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Direccion" class="form-label">Dirección</label><input asp-for="Input.Direccion" type="text" class="form-control" /><span asp-validation-for="Input.Direccion" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Grado" class="form-label">Grado actual</label><input asp-for="Input.Grado" type="text" class="form-control" /><span asp-validation-for="Input.Grado" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Sexo" class="form-label">Sexo</label><select asp-for="Input.Sexo" class="form-select"><option value="">Seleccionar</option><option value="F">Femenino</option><option value="M">Masculino</option></select><span asp-validation-for="Input.Sexo" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Modalidad" class="form-label">Modalidad</label><select asp-for="Input.Modalidad" class="form-select"><option value="">Seleccionar</option><option value="Preescolar">Preescolar</option><option value="Primaria">Primaria</option><option value="Secundaria">Secundaria</option></select><span asp-validation-for="Input.Modalidad" class="text-danger"></span></div>
</div>@if(Model.Edad is not null){<p class="mt-3">Edad: @Model.Edad años</p>}</fieldset><fieldset class="mb-4"><legend>Padre</legend><p class="text-muted">Completa los datos conocidos; no inventes información ausente.</p><div class="row g-3"><div class="col-md-6"><label asp-for="Input.Padre.Nombre" class="form-label">Nombre completo</label><input asp-for="Input.Padre.Nombre" type="text" class="form-control" /><span asp-validation-for="Input.Padre.Nombre" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Padre.Direccion" class="form-label">Dirección</label><input asp-for="Input.Padre.Direccion" type="text" class="form-control" /><span asp-validation-for="Input.Padre.Direccion" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Padre.CentroTrabajo" class="form-label">Centro de trabajo</label><input asp-for="Input.Padre.CentroTrabajo" type="text" class="form-control" /><span asp-validation-for="Input.Padre.CentroTrabajo" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Padre.Telefono" class="form-label">Teléfono</label><input asp-for="Input.Padre.Telefono" type="text" class="form-control" /><span asp-validation-for="Input.Padre.Telefono" class="text-danger"></span></div>
</div></fieldset><fieldset class="mb-4"><legend>Madre</legend><p class="text-muted">Completa los datos conocidos; no inventes información ausente.</p><div class="row g-3"><div class="col-md-6"><label asp-for="Input.Madre.Nombre" class="form-label">Nombre completo</label><input asp-for="Input.Madre.Nombre" type="text" class="form-control" /><span asp-validation-for="Input.Madre.Nombre" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Madre.Direccion" class="form-label">Dirección</label><input asp-for="Input.Madre.Direccion" type="text" class="form-control" /><span asp-validation-for="Input.Madre.Direccion" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Madre.CentroTrabajo" class="form-label">Centro de trabajo</label><input asp-for="Input.Madre.CentroTrabajo" type="text" class="form-control" /><span asp-validation-for="Input.Madre.CentroTrabajo" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Madre.Telefono" class="form-label">Teléfono</label><input asp-for="Input.Madre.Telefono" type="text" class="form-control" /><span asp-validation-for="Input.Madre.Telefono" class="text-danger"></span></div>
</div></fieldset><fieldset class="mb-4"><legend>Tutor diferente de los padres</legend><p class="text-muted">Completa los datos conocidos; no inventes información ausente.</p><div class="row g-3"><div class="col-md-6"><label asp-for="Input.Otro.Nombre" class="form-label">Nombre completo</label><input asp-for="Input.Otro.Nombre" type="text" class="form-control" /><span asp-validation-for="Input.Otro.Nombre" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Otro.Direccion" class="form-label">Dirección</label><input asp-for="Input.Otro.Direccion" type="text" class="form-control" /><span asp-validation-for="Input.Otro.Direccion" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Otro.CentroTrabajo" class="form-label">Centro de trabajo</label><input asp-for="Input.Otro.CentroTrabajo" type="text" class="form-control" /><span asp-validation-for="Input.Otro.CentroTrabajo" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Otro.Telefono" class="form-label">Teléfono</label><input asp-for="Input.Otro.Telefono" type="text" class="form-control" /><span asp-validation-for="Input.Otro.Telefono" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Otro.Parentesco" class="form-label">Parentesco</label><input asp-for="Input.Otro.Parentesco" type="text" class="form-control" /><span asp-validation-for="Input.Otro.Parentesco" class="text-danger"></span></div>
</div></fieldset><fieldset class="mb-4"><legend>Tutela legal</legend><div class="row g-3"><div class="col-md-6"><label asp-for="Input.Tutor" class="form-label">Responsable legal</label><select asp-for="Input.Tutor" class="form-select"><option value="">Seleccionar</option><option value="Padre">Padre</option><option value="Madre">Madre</option><option value="Otro">Otro</option></select><span asp-validation-for="Input.Tutor" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.DocumentoTutela" class="form-label">Referencia documental de tutela</label><input asp-for="Input.DocumentoTutela" type="text" class="form-control" /><span asp-validation-for="Input.DocumentoTutela" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Motivo" class="form-label">Motivo del registro o actualización</label><input asp-for="Input.Motivo" type="text" class="form-control" /><span asp-validation-for="Input.Motivo" class="text-danger"></span></div>
</div><p class="text-muted mt-2">Los cambios de responsable conservan el historial anterior.</p></fieldset><fieldset class="mb-4"><legend>Información médica</legend><p class="text-muted">Deja el tipo de sangre sin seleccionar si no está confirmado.</p><div class="row g-3"><div class="col-md-6"><label asp-for="Input.TipoSangre" class="form-label">Tipo de sangre</label><select asp-for="Input.TipoSangre" class="form-select"><option value="">Seleccionar</option><option value="A+">A+</option><option value="A-">A-</option><option value="B+">B+</option><option value="B-">B-</option><option value="AB+">AB+</option><option value="AB-">AB-</option><option value="O+">O+</option><option value="O-">O-</option></select><span asp-validation-for="Input.TipoSangre" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Alergias" class="form-label">Alergias</label><input asp-for="Input.Alergias" type="text" class="form-control" /><span asp-validation-for="Input.Alergias" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.Padecimientos" class="form-label">Padecimientos crónicos</label><input asp-for="Input.Padecimientos" type="text" class="form-control" /><span asp-validation-for="Input.Padecimientos" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.IndicacionesEmergencia" class="form-label">Indicaciones para emergencias</label><input asp-for="Input.IndicacionesEmergencia" type="text" class="form-control" /><span asp-validation-for="Input.IndicacionesEmergencia" class="text-danger"></span></div>
</div></fieldset><fieldset class="mb-4"><legend>Ingreso y documentación</legend><div class="row g-3"><div class="col-md-6"><label asp-for="Input.TipoIngreso" class="form-label">Tipo de ingreso</label><select asp-for="Input.TipoIngreso" class="form-select"><option value="">Seleccionar</option><option value="Nuevo">Nuevo ingreso</option><option value="Traslado">Traslado</option></select><span asp-validation-for="Input.TipoIngreso" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.CodigoTraslado" class="form-label">Código de traslado</label><input asp-for="Input.CodigoTraslado" type="text" class="form-control" /><span asp-validation-for="Input.CodigoTraslado" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.CentroProcedencia" class="form-label">Centro de procedencia</label><input asp-for="Input.CentroProcedencia" type="text" class="form-control" /><span asp-validation-for="Input.CentroProcedencia" class="text-danger"></span></div>
</div><div class="mt-3"><div class="form-check"><input asp-for="Input.PartidaRecibida" class="form-check-input" /><label asp-for="Input.PartidaRecibida" class="form-check-label">Partida de nacimiento recibida</label></div><div class="form-check"><input asp-for="Input.IdentificacionTutorRecibida" class="form-check-input" /><label asp-for="Input.IdentificacionTutorRecibida" class="form-check-label">Identificación del tutor recibida</label></div><div class="form-check"><input asp-for="Input.BoletinRecibido" class="form-check-input" /><label asp-for="Input.BoletinRecibido" class="form-check-label">Boletín recibido</label></div><div class="form-check"><input asp-for="Input.TrasladoRecibido" class="form-check-input" /><label asp-for="Input.TrasladoRecibido" class="form-check-label">Documento de traslado recibido</label></div></div></fieldset>
<button type="submit" class="btn btn-liceo-primary">Guardar expediente</button>
<a asp-page="Index" class="btn btn-liceo-secondary">Volver al listado</a>
</form>
@if(Model.Historial.Rows.Count>0) {
<section class="liceo-card mt-4"><h2 class="h4">Historial de tutores</h2><div class="table-responsive"><table class="table"><thead><tr><th>Responsable</th><th>Vínculo</th><th>Desde</th><th>Hasta</th><th>Motivo</th></tr></thead><tbody>
@foreach(System.Data.DataRow fila in Model.Historial.Rows) { <tr><td>@fila["NombreHistorico"]</td><td>@fila["Vinculo"]</td><td>@Convert.ToDateTime(fila["Desde"]).ToString("dd/MM/yyyy")</td><td>@(fila.IsNull("Hasta") ? "Vigente" : Convert.ToDateTime(fila["Hasta"]).ToString("dd/MM/yyyy"))</td><td>@fila["Motivo"]</td></tr> }
</tbody></table></div></section>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
