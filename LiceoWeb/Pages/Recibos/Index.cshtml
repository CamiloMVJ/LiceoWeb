@* @page
@model LiceoWeb.Pages.Recibos.IndexModel
@{
}
 *@

@page
@{
    ViewData["Title"] = "Historial General de Recibos";
}

<style>
    :root {
        --bg-main: #F4F6F8;
        --color-primary: #1B264F;
        --color-accent: #C99700;
        --color-primary-dark: #121A38;
    }

    body {
        background-color: var(--bg-main);
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    .header-dashboard {
        background: #FFFFFF;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(27, 38, 79, 0.05);
        border-left: 6px solid var(--color-accent);
    }

    .filter-card {
        background: #FFFFFF;
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    }

    .form-control-custom, .form-select-custom {
        border: 1.5px solid #E2E8F0;
        border-radius: 10px;
        padding: 0.65rem 1rem;
        font-size: 0.95rem;
    }

    .btn-primary-custom {
        background-color: var(--color-primary);
        color: #FFFFFF;
        font-weight: 600;
        border-radius: 10px;
        padding: 0.65rem 1.4rem;
        border: none;
        transition: all 0.2s;
    }

        .btn-primary-custom:hover {
            background-color: var(--color-primary-dark);
            color: #FFFFFF;
            box-shadow: 0 4px 12px rgba(27, 38, 79, 0.25);
        }

    .table-container {
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid #EDF2F7;
    }

    .table-custom {
        margin: 0;
    }

        .table-custom thead {
            background-color: var(--color-primary);
            color: #FFFFFF;
        }

        .table-custom th {
            font-weight: 600;
            font-size: 0.88rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 1rem 1.25rem;
            border: none;
        }

    .empty-state {
        padding: 4rem 2rem;
        background-color: #FAFAFC;
    }

    .empty-icon-wrapper {
        width: 80px;
        height: 80px;
        background-color: #F1F5F9;
        color: var(--color-primary);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        margin-bottom: 1rem;
    }
</style>

<div class="container py-4">

    <!-- ENCABEZADO DE LA PÁGINA -->
    <div class="header-dashboard p-4 mb-4 d-flex justify-content-between align-items-center">
        <div>
            <span class="badge px-3 py-2 text-uppercase mb-2 fw-bold" style="background-color: rgba(201, 151, 0, 0.15); color: var(--color-accent); border-radius: 8px;">
                <i class="bi bi-receipt-cutoff me-1"></i> Registro Unificado
            </span>
            <h2 class="fw-bold m-0" style="color: var(--color-primary);">
                Historial General de Recibos
            </h2>
            <p class="text-muted m-0 mt-1 fs-6">Búsqueda, consulta y reimpresión de comprobantes emitidos por todo el sistema.</p>
        </div>
        <div class="text-end">
            <a class="btn btn-outline-secondary btn-sm bg-white shadow-sm" asp-page="/Recibos/Comprobante" target="_blank">
                <i class="bi bi-printer me-1"></i> Formato Imprimible Common[cite: 1]
            </a>
        </div>
    </div>

    <!-- FILTROS DE BÚSQUEDA Y SELECCIÓN -->
    <div class="filter-card p-4 mb-4">
        <div class="d-flex align-items-center mb-3">
            <i class="bi bi-funnel-fill me-2 fs-5" style="color: var(--color-accent);"></i>
            <h5 class="fw-bold m-0" style="color: var(--color-primary);">Filtros del Historial</h5>
        </div>

        <form method="get">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Concepto de Cobro</label>
                    <select class="form-select form-select-custom" name="conceptoFiltro">
                        <option value="Todos">Todos los conceptos</option>
                        <option value="Mantenimiento">Mantenimiento</option>
                        <option value="EvBoTa">EvBoTa</option>
                        <option value="Promocion">Promoción</option>
                        <option value="Matricula">Matrícula</option>
                        <option value="Mensualidad">Mensualidad</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Método de Pago</label>
                    <select class="form-select form-select-custom" name="metodoFiltro">
                        <option value="Todos">Todos los métodos</option>
                        <option value="Efectivo">Efectivo</option>
                        <option value="Transferencia">Transferencia</option>
                        <option value="Saldo">Saldo a favor</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary small">Buscar por Estudiante o Comprobante</label>
                    <input type="text" class="form-control form-control-custom" name="busquedaGeneral" placeholder="Código estudiante o ID comprobante...">
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary-custom w-100">
                        <i class="bi bi-search me-1"></i> Filtrar
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- TABLA DE RECIBOS EMITIDOS -->
    <div class="filter-card p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold m-0" style="color: var(--color-primary);">
                <i class="bi bi-clock-history me-2" style="color: var(--color-accent);"></i>Comprobantes Registrados
            </h5>
            <span class="badge px-3 py-2 text-dark border" style="background-color: #F8FAFC; border-radius: 8px;">
                <strong>0</strong> recibos
            </span>
        </div>

        <div class="table-container">
            <table class="table table-custom table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nº Comprobante</th>
                        <th>Fecha de Pago</th>
                        <th>Registro Estudiante</th>
                        <th>Concepto</th>
                        <th>Método</th>
                        <th>Referencia</th>
                        <th>Monto Total</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- ESTADO VACÍO (Sin datos quemados) -->
                    <tr>
                        <td colspan="8" class="text-center empty-state">
                            <div class="empty-icon-wrapper">
                                <i class="bi bi-journal-x"></i>
                            </div>
                            <h5 class="fw-bold" style="color: var(--color-primary);">No se encontraron recibos</h5>
                            <p class="text-muted mb-0 fs-6">No existen comprobantes emitidos en el historial para los parámetros ingresados.</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>