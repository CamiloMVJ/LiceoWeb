@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    var paginaActual =
        ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var areaActual =
        ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    var esPortada =
        string.IsNullOrEmpty(areaActual)
        && paginaActual.Equals(
            "/Index",
            StringComparison.OrdinalIgnoreCase);
}

<div class="liceo-session">
    @if (SignInManager.IsSignedIn(User))
    {
        @if (esPortada
            && (User.IsInRole("Administrador")
            || User.IsInRole("Profesor")
            || User.IsInRole("Cajero")))
        {
            <a asp-area=""
               asp-page="/Panel/Index"
               class="liceo-session-button liceo-session-button-primary">
                Entrar al sistema
            </a>
        }

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })"
              method="post"
              class="liceo-session-form">

            <button type="submit"
                    class="liceo-session-button liceo-session-button-outline">
                Cerrar sesión
            </button>
        </form>
    }
    else
    {
        <a asp-area="Identity"
           asp-page="/Account/Login"
           asp-route-returnUrl="@Url.Page("/Index", new { area = "" })"
           class="liceo-session-button liceo-session-button-primary">
            Iniciar sesión
        </a>
    }
</div>