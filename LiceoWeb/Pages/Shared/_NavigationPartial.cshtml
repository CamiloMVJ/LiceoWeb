@{
    var paginaActual =
        ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var areaActual =
        ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    bool EstaActivo(string pagina)
    {
        return string.IsNullOrEmpty(areaActual)
            && paginaActual.Equals(
                pagina,
                StringComparison.OrdinalIgnoreCase);
    }

    string? AriaActual(string pagina) =>
        EstaActivo(pagina) ? "page" : null;
}

<p class="liceo-menu-title">Menú principal</p>

<nav class="liceo-menu" aria-label="Módulos del sistema">
    <a asp-area=""
       asp-page="/Panel/Index"
       class="@(EstaActivo("/Panel/Index") ? "active" : "")"
       aria-current="@AriaActual("/Panel/Index")">
        Inicio del sistema
    </a>

    @if (User.IsInRole("Administrador") || User.IsInRole("Cajero"))
    {
    <a asp-area="" asp-page="/Finanzas/Cuenta" class="@(EstaActivo("/Finanzas/Cuenta") ? "active" : "")" aria-current="@AriaActual("/Finanzas/Cuenta")">Cobrar a estudiante</a>
    <a asp-area=""
       asp-page="/Estudiantes/Index"
       class="@(EstaActivo("/Estudiantes/Index") ? "active" : "")"
       aria-current="@AriaActual("/Estudiantes/Index")">
        Estudiantes y matrícula
    </a>

    }
    @if (User.IsInRole("Administrador"))
    {
        <div class="liceo-menu-divider"></div>

        <p class="liceo-menu-title">Administración</p>
        <a asp-page="/Finanzas/Cortes" class="@(EstaActivo("/Finanzas/Cortes") ? "active" : "")">Cortes de caja</a>
        <a asp-page="/Finanzas/Reporte" class="@(EstaActivo("/Finanzas/Reporte") ? "active" : "")">Cobros y devoluciones</a>
        <a asp-page="/Finanzas/Cargos" class="@(EstaActivo("/Finanzas/Cargos") ? "active" : "")">Generar cargos</a>
        <a asp-area="" asp-page="/Finanzas/Aranceles" class="@(EstaActivo("/Finanzas/Aranceles") ? "active" : "")">Aranceles y tarifas</a>
        <a asp-area="" asp-page="/Notas/Cierre" class="@(EstaActivo("/Notas/Cierre") ? "active" : "")">Cierre e historial académico</a>
        <a asp-page="/Planificacion/Index" class="@(EstaActivo("/Planificacion/Index") ? "active" : "")">Organización académica</a>
        <a asp-area="" asp-page="/Personal/Administrar" class="@(EstaActivo("/Personal/Administrar") || EstaActivo("/Personal/Index") ? "active" : "")">Cuentas del personal</a>

    }
    @if(User.IsInRole("Administrador") || User.IsInRole("Profesor")) {
        <a asp-page="/Notas/Index" class="@(EstaActivo("/Notas/Index") ? "active" : "")">Calificaciones</a>
    }
    @if(User.IsInRole("Profesor")) {
        <a asp-page="/Planificacion/MiHorario" class="@(EstaActivo("/Planificacion/MiHorario") ? "active" : "")">Mi horario</a>
    }
</nav>