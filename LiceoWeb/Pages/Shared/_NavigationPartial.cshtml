@{
    var paginaActual =
        ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var areaActual =
        ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    bool EstaActivo(string pagina)
    {
        return string.IsNullOrEmpty(areaActual)
            && paginaActual.Equals(
                pagina,
                StringComparison.OrdinalIgnoreCase);
    }

    string? AriaActual(string pagina) =>
        EstaActivo(pagina) ? "page" : null;
}

<p class="liceo-menu-title">Menú principal</p>

<nav class="liceo-menu" aria-label="Módulos del sistema">
    <a asp-area=""
       asp-page="/Panel/Index"
       class="@(EstaActivo("/Panel/Index") ? "active" : "")"
       aria-current="@AriaActual("/Panel/Index")">
        Inicio del sistema
    </a>

    @if (User.IsInRole("Administrador") || User.IsInRole("Cajero"))
    {
    <a asp-area=""
       asp-page="/Estudiantes/Index"
       class="@(EstaActivo("/Estudiantes/Index") ? "active" : "")"
       aria-current="@AriaActual("/Estudiantes/Index")">
        Estudiantes y matrícula
    </a>

    <a asp-area=""
       asp-page="/Mensualidades/Index"
       class="@(EstaActivo("/Mensualidades/Index") ? "active" : "")"
       aria-current="@AriaActual("/Mensualidades/Index")">
        Mensualidades
    </a>

    <a asp-area=""
       asp-page="/Mensualidades/GestionMensualidades"
       class="@(EstaActivo("/Mensualidades/GestionMensualidades") ? "active" : "")"
       aria-current="@AriaActual("/Mensualidades/GestionMensualidades")">
        Gestión de Mensualidades
    </a>

    <a asp-area=""
       asp-page="/Cobros/Index"
       class="@(EstaActivo("/Cobros/Index") ? "active" : "")"
       aria-current="@AriaActual("/Cobros/Index")">

        Mantenimiento
    </a>

    <a asp-area=""
       asp-page="/Cobros/EvBoTa"   
       class="@(EstaActivo("/Cobros/EvBoTa") ? "active" : "")"
       aria-current="@AriaActual("/Cobros/EvBoTa")">
        Evaluaciones, boletín y tarjeta
    </a>

    <a asp-area=""
       asp-page="/Cobros/Promocion" 
       class="@(EstaActivo("/Cobros/Promocion") ? "active" : "")"
       aria-current="@AriaActual("/Cobros/Promocion")">
        Promoción
    </a>

    <a asp-area=""
       asp-page="/Recibos/Index"
       class="@(EstaActivo("/Recibos/Index") ? "active" : "")"
       aria-current="@AriaActual("/Recibos/Index")">
        Comprobantes
    </a>

    }
    @if (User.IsInRole("Administrador"))
    {
        <div class="liceo-menu-divider"></div>

        <p class="liceo-menu-title">Administración</p>
        <a asp-page="/Planificacion/Index" class="@(EstaActivo("/Planificacion/Index") ? "active" : "")">Planificación académica</a>
        <a asp-page="/Planificacion/Catalogos" class="@(EstaActivo("/Planificacion/Catalogos") ? "active" : "")">Catálogos académicos</a>
        <a asp-area="" asp-page="/Personal/Index">Cuentas del personal</a>

        <a asp-area=""
           asp-page="/Arreglos/Index"
           class="@(EstaActivo("/Arreglos/Index") ? "active" : "")"
           aria-current="@AriaActual("/Arreglos/Index")">
            Arreglos de pago
        </a>

        <a asp-area=""
           asp-page="/Precios/Index"
           class="@(EstaActivo("/Precios/Index") ? "active" : "")"
           aria-current="@AriaActual("/Precios/Index")">
            Tarifas
        </a>

        <a asp-area=""
           asp-page="/Reportes/Index"
           class="@(EstaActivo("/Reportes/Index") ? "active" : "")"
           aria-current="@AriaActual("/Reportes/Index")">
            Reportes
        </a>
    }
    @if(User.IsInRole("Administrador") || User.IsInRole("Profesor")) {
        <a asp-page="/Notas/Index" class="@(EstaActivo("/Notas/Index") ? "active" : "")">Calificaciones</a>
    }
    @if(User.IsInRole("Profesor")) {
        <a asp-page="/Planificacion/MiHorario" class="@(EstaActivo("/Planificacion/MiHorario") ? "active" : "")">Mi horario</a>
    }
</nav>