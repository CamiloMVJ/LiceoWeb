@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    var paginaActual =
        ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    var areaActual =
        ViewContext.RouteData.Values["area"]?.ToString() ?? "";

    var esPortada =
        string.IsNullOrEmpty(areaActual)
        && paginaActual.Equals(
            "/Index",
            StringComparison.OrdinalIgnoreCase);

    var mostrarMenu =
        !esPortada
        && SignInManager.IsSignedIn(User)
        && (User.IsInRole("Administrador")
            || User.IsInRole("Profesor"));
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Liceo Hispanidad</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/LiceoWeb.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="liceo-header">
        <div class="liceo-header-inner">
            <a class="liceo-brand"
               asp-area=""
               asp-page="/Index">
                Liceo Hispanidad
            </a>

            <partial name="_LoginPartial" />
        </div>
    </header>

    <div class="liceo-shell">
        @if (mostrarMenu)
        {
            <aside class="liceo-sidebar">
                <partial name="_NavigationPartial" />
            </aside>
        }

        <main id="contenido-principal"
              class="liceo-main @(!mostrarMenu ? "liceo-main-public" : "")"
              tabindex="-1">

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>