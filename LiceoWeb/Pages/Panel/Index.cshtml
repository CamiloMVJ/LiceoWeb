@page
@model LiceoWeb.Pages.Panel.IndexModel
@{ ViewData["Title"] = "Inicio del sistema"; }
<header class="ui-welcome">
    <p class="ui-kicker">Liceo Hispanidad · Gestión interna</p>
    <h1>Tu espacio de trabajo</h1>
    <p class="mb-0">Gestiona la información académica y los cobros desde un mismo lugar.</p>
</header>
<section aria-labelledby="modulos-title">
    <h2 id="modulos-title" class="mb-3">¿Qué necesitas hacer?</h2>
    <div class="ui-module-grid">
    @if (User.IsInRole("Administrador") || User.IsInRole("Cajero"))
    {
        <a class="ui-module" asp-page="/Estudiantes/Index"><p class="ui-kicker">Estudiantes</p><h2>Expedientes y matrícula</h2><p>Consulta estudiantes y abre su cuenta para cobrar.</p><span>Abrir estudiantes →</span></a>
        <a class="ui-module" asp-page="/Finanzas/Cuenta"><p class="ui-kicker">Finanzas</p><h2>Cobrar a estudiante</h2><p>Revisa los cargos de un estudiante, registra pagos y consulta recibos.</p><span>Buscar estudiante →</span></a>
    }
    @if (User.IsInRole("Administrador"))
    {
        <a class="ui-module" asp-page="/Planificacion/Index"><p class="ui-kicker">Organización académica</p><h2>Organización académica</h2><p>Prepara el año y organiza cada grupo hasta llegar a sus calificaciones.</p><span>Organizar el año y sus grupos →</span></a>
        <a class="ui-module" asp-page="/Finanzas/Cargos"><p class="ui-kicker">Administración</p><h2>Cargos y mensualidades</h2><p>Asigna obligaciones a partir de las tarifas vigentes del colegio.</p><span>Gestionar cargos →</span></a>
        <a class="ui-module" asp-page="/Finanzas/Cortes"><p class="ui-kicker">Administración de caja</p><h2>Cortes de caja</h2><p>Revisa, cierra y abre períodos de cobro desde el sistema.</p><span>Administrar caja →</span></a>
        <a class="ui-module" asp-page="/Finanzas/Reporte"><p class="ui-kicker">Seguimiento financiero</p><h2>Cobros y devoluciones</h2><p>Consulta movimientos y totales por período, separados por método.</p><span>Consultar reporte →</span></a>
    }
    @if (User.IsInRole("Administrador") || User.IsInRole("Profesor"))
    {
        <a class="ui-module" asp-page="/Notas/Index"><p class="ui-kicker">Evaluación</p><h2>Calificaciones</h2><p>Accede a las asignaturas y evaluaciones autorizadas para tu cuenta.</p><span>Abrir calificaciones →</span></a>
    }
    @if (User.IsInRole("Profesor"))
    {
        <a class="ui-module" asp-page="/Planificacion/MiHorario"><p class="ui-kicker">Docencia</p><h2>Mi horario</h2><p>Consulta tus clases, grupos y aulas asignadas.</p><span>Consultar horario →</span></a>
    }
    </div>
</section>
