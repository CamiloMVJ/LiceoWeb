@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="liceo-login" aria-labelledby="login-title">
    <div class="liceo-login-card">

        <div class="liceo-login-intro">
            <div class="liceo-login-emblem" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="34"
                     height="34"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.6"
                     stroke-linecap="round"
                     stroke-linejoin="round"
                     focusable="false">
                    <path d="M12 7v14" />
                    <path d="M3 3h5a4 4 0 0 1 4 4
                             4 4 0 0 1 4-4h5v16h-5
                             a4 4 0 0 0-4 2
                             4 4 0 0 0-4-2H3z" />
                </svg>
            </div>

            <p class="liceo-login-school">Liceo Hispanidad</p>

            <h1 id="login-title">Bienvenido</h1>

            <p class="liceo-login-description">
                Ingresa con tu cuenta para acceder al sistema.
            </p>
        </div>

        <div class="liceo-login-content">
            <form id="account" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="liceo-login-errors"
                     role="alert">
                </div>

                <div class="mb-4">
                    <label asp-for="Input.Email" class="form-label">
                        Correo electrónico
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control liceo-login-input"
                           type="email"
                           autocomplete="username"
                           aria-required="true"
                           aria-describedby="email-error"
                           placeholder="nombre@ejemplo.com" />

                    <span asp-validation-for="Input.Email"
                          id="email-error"
                          class="liceo-login-field-error">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">
                        Contraseña
                    </label>

                    <input asp-for="Input.Password"
                           class="form-control liceo-login-input"
                           type="password"
                           autocomplete="current-password"
                           aria-required="true"
                           aria-describedby="password-error"
                           placeholder="Ingresa tu contraseña" />

                    <span asp-validation-for="Input.Password"
                          id="password-error"
                          class="liceo-login-field-error">
                    </span>
                </div>

                <div class="form-check liceo-login-remember">
                    <input asp-for="Input.RememberMe"
                           class="form-check-input" />

                    <label asp-for="Input.RememberMe"
                           class="form-check-label">
                        Mantener mi sesión iniciada
                    </label>
                </div>

                <button id="login-submit"
                        type="submit"
                        class="liceo-login-submit">
                    Iniciar sesión
                </button>

                <p class="liceo-login-help">
                    Si necesitas acceso o ayuda con tu cuenta,
                    contacta al administrador del sistema.
                </p>
            </form>
        </div>

        <div class="liceo-login-footer">
            Acceso exclusivo para personal autorizado
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}